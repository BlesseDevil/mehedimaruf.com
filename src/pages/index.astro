---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Spotlight from "../components/Spotlight.astro";
import CursorRing from "../components/CursorRing.astro";
import SectionNav from "../components/SectionNav.astro";
import LeftRail from "../components/LeftRail.astro";
import PhotoCrossfade from "../components/PhotoCrossfade.astro";
import Socials from "../components/Socials.astro";
import TitleMorph from "../components/TitleMorph.astro";
import ContactForm from "../components/ContactForm.astro";
import { profile } from "../lib/site-data";
import { byRecency } from "../lib/cv";
import { EMAILS, SITE, PSEUDONYM } from "../config";

/** Live entries only — drafts stay out of every listing. */
const published = <T extends { data: { draft: boolean } }>(entries: T[]) =>
  entries.filter((entry) => !entry.data.draft);

const projects = published(await getCollection("projects"));
const posts = published(await getCollection("blog"));

interface Card {
  kind: string;
  title: string;
  summary: string;
  href: string;
  date: Date;
  /** `featured: true` in the entry — it goes first in its tab, marked as pinned. */
  pinned: boolean;
}

const projectCard = (p: (typeof projects)[number]): Card => ({
  kind: p.data.band === "irl" ? "Project" : "Software",
  title: p.data.title,
  summary: p.data.summary,
  href: `/projects/${p.id}`,
  date: p.data.updated ?? p.data.date,
  pinned: p.data.featured,
});

const postCard = (p: (typeof posts)[number]): Card => ({
  kind: p.data.external ? p.data.external.publication : "Writing",
  title: p.data.title,
  summary: p.data.description,
  href: p.data.external?.url ?? `/blog/${p.id}`,
  date: p.data.date,
  pinned: p.data.featured,
});

/** Pinned entries first, then newest first; three to a tab. */
const top = (cards: Card[]) =>
  cards
    .sort((a, b) => Number(b.pinned) - Number(a.pinned) || b.date.valueOf() - a.date.valueOf())
    .slice(0, 3);

/**
 * Featured is one tab per kind of work rather than a single mixed row. Mixed,
 * the three newest items were always software, and the writing never surfaced
 * above the fold of its own section. Software leads because it is the lead.
 */
const featuredTabs = [
  {
    id: "software",
    label: "Software",
    cards: top(projects.filter((p) => p.data.band === "software").map(projectCard)),
    more: { href: "/projects#software", label: "All software" },
  },
  {
    id: "writing",
    label: "Writing",
    cards: top(posts.map(postCard)),
    more: { href: "/blog", label: "All writing" },
  },
  {
    id: "irl",
    label: "In the world",
    cards: top(projects.filter((p) => p.data.band === "irl").map(projectCard)),
    more: { href: "/projects#irl", label: "All delivery work" },
  },
].filter((tab) => tab.cards.length > 0);

/**
 * One mixed strip rather than separate "latest posts" and "latest projects"
 * rows: it stays full even when one side of the work is quiet.
 */
const recent = [
  ...projects.map((p) => ({
    kind: p.data.band === "irl" ? "Project" : "Software",
    title: p.data.title,
    summary: p.data.summary,
    href: `/projects/${p.id}`,
    date: p.data.updated ?? p.data.date,
  })),
  ...posts.map((p) => ({
    kind: p.data.external ? p.data.external.publication : "Writing",
    title: p.data.title,
    summary: p.data.description,
    href: p.data.external?.url ?? `/blog/${p.id}`,
    date: p.data.date,
  })),
]
  .sort((a, b) => b.date.valueOf() - a.date.valueOf())
  .slice(0, 4);

/**
 * The résumé card's facts come from the same collections and the same sort as
 * the CV pages, so the card cannot drift from what /cv says. A row whose data
 * is missing is simply left out.
 */
const [latestJob, ...earlierJobs] = byRecency(await getCollection("experience"));
const [latestDegree] = byRecency(await getCollection("education"));
const [latestResearch] = byRecency(await getCollection("research"));

interface Fact {
  label: string;
  value: string;
  clamp?: boolean;
  tags?: { text: string; title: string }[];
}

const factRows: (Fact | false | undefined)[] = [
  latestJob && { label: "Now", value: `${latestJob.data.role} · ${latestJob.data.org}` },
  // The rest of the career in one line of tags: where, with the role on hover.
  // The detail is what the two buttons below are for.
  earlierJobs.length > 0 && {
    label: "Previously",
    value: "",
    tags: earlierJobs.map((job) => ({
      text: job.data.org,
      title: `${job.data.role}, ${job.data.start}–${job.data.end}`,
    })),
  },
  latestDegree && {
    label: "Education",
    value: `${latestDegree.data.degree} · ${latestDegree.data.institution}`,
  },
  latestResearch && { label: "Research", value: latestResearch.data.title, clamp: true },
  profile.languages.length > 0 && {
    label: "Languages",
    value: profile.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(" · "),
  },
];
const resumeFacts = factRows.filter((fact): fact is Fact => Boolean(fact));

const sections = [
  { id: "top", label: "Intro", show: true },
  { id: "about", label: "About", show: true },
  { id: "resume", label: "Résumé", show: true },
  { id: "featured", label: "Featured", show: featuredTabs.length > 0 },
  { id: "recent", label: "Recent", show: recent.length > 0 },
  { id: "contact", label: "Contact", show: true },
].filter((s) => s.show);

/** The site's other pages, offered in the same navigator as the sections. */
const pages = [
  { href: "/projects", label: "Projects" },
  { href: "/blog", label: "Writing" },
];

const dateLabel = (value: Date) =>
  value.toLocaleDateString("en-GB", { month: "short", year: "numeric" });
---

<BaseLayout morph>
  <Spotlight />
  <CursorRing />
  <LeftRail sections={sections} pages={pages} />
  <TitleMorph />

  <section id="top" class="hero">
    <div class="hero-text">
      {
        profile.positioning.length > 0 && (
          <p class="eyebrow">{profile.positioning.join(" · ")}</p>
        )
      }
      {/* No morph on a phone: the photo stacks above this text there, and the
          travel carried the name straight over the portrait. */}
      <h1 data-hero-title data-morph-off="(max-width: 60rem)">{profile.name}</h1>
      <p class="role">{profile.role}</p>
      {profile.motto && <blockquote class="motto">{profile.motto}</blockquote>}

      <div class="cta">
        <a class="button primary" href="/resume">View résumé</a>
        <a class="button" href={`mailto:${EMAILS.contact}`}>Get in touch</a>
      </div>

      {/* Where the socials start. They hand over to the fixed top-right rail
          once the hero name has shrunk into the header. */}
      <div class="hero-socials">
        <Socials variant="inline" />
      </div>
    </div>

    <div class="hero-photo">
      <PhotoCrossfade />
    </div>

    <a class="scroll-hint" href="#about" aria-label="Scroll to About">
      <span>Scroll</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14m0 0 5-5m-5 5-5-5" /></svg>
    </a>
  </section>

  <div class="mobile-nav">
    <SectionNav sections={sections} pages={pages} variant="menu" />
  </div>

  <section id="about" class="band">
    <h2>About</h2>
    <div class="about">
      <div>
        <p class="lede">{profile.about}</p>
        {/* Both names in plain text: people search for the short one, and for
            the name the software is published under. */}
        <p class="aka">
          Most people call me {SITE.shortName}. My software is published as{" "}
          <a href="/projects">{PSEUDONYM.name}</a>.
        </p>
      </div>
      {
        profile.proofPoints.length > 0 && (
          <ul class="proof">
            {profile.proofPoints.map((point) => (
              <li>
                <span class="value">{point.value}</span>
                <span class="label">{point.label}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <section id="resume" class="band">
    <h2>Résumé</h2>
    <div class="resume-card">
      {
        resumeFacts.length > 0 && (
          <dl class="facts">
            {resumeFacts.map((fact) => (
              <div class="fact">
                <dt>{fact.label}</dt>
                <dd class:list={[fact.clamp && "clamp"]}>
                  {fact.tags ? (
                    <ul class="tags">
                      {fact.tags.map((tag) => (
                        <li title={tag.title}>{tag.text}</li>
                      ))}
                    </ul>
                  ) : (
                    fact.value
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
      <div class="cta">
        <a class="button primary" href="/resume">View résumé</a>
        <a class="button" href="/cv">Full CV</a>
      </div>
    </div>
  </section>

  {
    featuredTabs.length > 0 && (
      <section id="featured" class="band" data-feature-tabs>
        <h2>Featured</h2>
        {featuredTabs.length > 1 && (
          <div class="tabs" role="tablist" aria-label="Featured work">
            {featuredTabs.map((tab, index) => (
              <button
                type="button"
                role="tab"
                id={`feature-tab-${tab.id}`}
                aria-controls={`feature-panel-${tab.id}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
                data-feature-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>
        )}
        {featuredTabs.map((tab, index) => (
          <div
            class="panel"
            role="tabpanel"
            id={`feature-panel-${tab.id}`}
            aria-labelledby={`feature-tab-${tab.id}`}
            data-feature-panel={tab.id}
            hidden={index !== 0}
          >
            <ul class="cards">
              {tab.cards.map((item) => (
                <li>
                  <a href={item.href}>
                    <span class="kind">
                      {item.kind}
                      {tab.id === "writing" && item.pinned && <span class="pin">Pinned</span>}
                    </span>
                    <h3>{item.title}</h3>
                    <p>{item.summary}</p>
                  </a>
                </li>
              ))}
            </ul>
            <p class="more">
              <a href={tab.more.href}>{tab.more.label} →</a>
            </p>
          </div>
        ))}
        {/* Without scripts the tabs cannot switch, so every panel is shown. */}
        <noscript>
          <style is:inline>
            [data-feature-panel][hidden] { display: block !important; margin-top: 1.5rem; }
            [data-feature-tabs] .tabs { display: none; }
          </style>
        </noscript>
      </section>
    )
  }

  {
    recent.length > 0 && (
      <section id="recent" class="band">
        <h2>Recent</h2>
        <ul class="strip">
          {recent.map((item) => (
            <li>
              <a href={item.href}>
                <span class="kind">{item.kind}</span>
                <h3>{item.title}</h3>
                <span class="when">{dateLabel(item.date)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section id="contact" class="band contact">
    <h2>Contact</h2>
    <p class="lede">
      Open to work in software and language data — and always glad to talk about Bangla
      language technology, or about the tools on this site.
    </p>
    <ContactForm />
    <ul class="elsewhere">
      {
        profile.links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener me">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  /**
   * Featured tabs: click or arrow keys switch the panel. The first panel is
   * already visible in the HTML, so nothing moves when this loads.
   */
  function initFeatureTabs() {
    const root = document.querySelector<HTMLElement>("[data-feature-tabs]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "true";

    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-feature-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-feature-panel]")];

    const select = (id: string, focus = false) => {
      for (const tab of tabs) {
        const on = tab.dataset.featureTab === id;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      }
      for (const panel of panels) panel.hidden = panel.dataset.featurePanel !== id;
      // Remembered for this browser tab, so coming Back from a card returns to
      // the tab it was opened from rather than to Software.
      try {
        sessionStorage.setItem("mm-feature-tab", id);
      } catch (e) {
        /* blocked storage: the tab simply starts at the first one */
      }
    };

    const restore = () => {
      try {
        const saved = sessionStorage.getItem("mm-feature-tab");
        if (saved && tabs.some((tab) => tab.dataset.featureTab === saved)) select(saved);
      } catch (e) {
        /* nothing saved */
      }
    };
    restore();
    // A page restored from the back/forward cache does not run scripts again.
    window.addEventListener("pageshow", restore);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(tab.dataset.featureTab!));
      tab.addEventListener("keydown", (event) => {
        const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        const next = tabs[(index + step + tabs.length) % tabs.length]!;
        select(next.dataset.featureTab!, true);
      });
    });
  }

  initFeatureTabs();
  document.addEventListener("astro:page-load", initFeatureTabs);
</script>

<style>
  /* Narrower than the CV: this page is mostly prose, and the slimmer column
     leaves the gutters free for the two fixed rails. */
  .hero,
  .band {
    position: relative;
    z-index: 1;
    max-width: 62rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    scroll-margin-top: 4rem;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .hero {
    min-height: min(88vh, 46rem);
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: clamp(2rem, 6vh, 5rem) 6rem;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.9rem;
  }

  h1 {
    font-size: clamp(2.7rem, 7vw, 5rem);
    letter-spacing: -0.025em;
    margin: 0;
    /* The title shrinks into the header as you scroll, so it has to ride above
       the header's own background until the handover is done. */
    position: relative;
    z-index: 31;
    transform-origin: left top;
    will-change: transform;
  }

  h1[data-parked] {
    visibility: hidden;
  }

  .role {
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--muted);
    max-width: 34ch;
    margin: 1rem 0 0;
  }

  .motto {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--muted);
    border-left: 2px solid var(--gold);
    margin: 1.5rem 0 0;
    padding-left: 1rem;
    max-width: 42ch;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .button {
    display: inline-block;
    padding: 0.7rem 1.3rem;
    border: 1px solid var(--accent);
    border-radius: 0.45rem;
    color: var(--accent);
    text-decoration: none;
    font-size: 0.95rem;
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .button:hover {
    background: var(--accent-soft);
    transform: translateY(-2px);
  }

  .button.primary {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .button.primary:hover {
    background: var(--accent-hover);
  }

  .hero-socials {
    margin-top: 2rem;
    transition: opacity 320ms var(--ease);
  }

  /* Once the rail has them, the hero's copy fades out rather than the two
     sitting on screen together. Only where the rail exists: below its
     breakpoint these are the only socials on the page. */
  @media (min-width: 80.0625rem) {
    :global(.site-head[data-title-parked]) ~ :global(#main) .hero-socials {
      opacity: 0;
      pointer-events: none;
    }
  }

  /* The frame breathes: a degree of rotation and a few pixels of rise, over
     eleven seconds. Deliberately below the threshold where you would call it
     an animation — it reads as a photograph being straightened, not as
     something moving. The frame itself leans towards the cursor, so the float
     is applied out here, a level up, where the two cannot fight over the same
     transform. */
  .hero-photo {
    justify-self: end;
    animation: hero-float 11s ease-in-out infinite alternate;
    will-change: transform;
  }

  @keyframes hero-float {
    from {
      transform: rotate(-0.7deg) translateY(4px);
    }
    to {
      transform: rotate(0.7deg) translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-photo {
      animation: none;
    }
  }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    color: var(--muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .scroll-hint svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: hero-nudge 2.4s var(--ease) infinite;
  }

  @keyframes hero-nudge {
    0%, 100% { transform: translateY(0); opacity: 0.6; }
    50% { transform: translateY(0.3rem); opacity: 1; }
  }

  .scroll-hint:hover {
    color: var(--accent);
  }

  /* The chip bar replaces the rail below the rail's breakpoint, and pins itself
     under the header so the sections stay reachable while reading. */
  .mobile-nav {
    position: sticky;
    /* The header's measured height, published by its own script. Hard-coding
       3.5rem against an 84px bar left 28px of the chips underneath it. */
    top: var(--head-h, 5.25rem);
    z-index: 20;
    max-width: 62rem;
    margin: 0 auto;
    padding-inline: clamp(1rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  @media (min-width: 80.0625rem) {
    .mobile-nav {
      display: none;
    }
  }

  /* ── Bands ────────────────────────────────────────────────────────────── */
  .band {
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .lede {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    max-width: var(--measure);
    margin: 0;
  }

  .aka {
    color: var(--muted);
    max-width: var(--measure);
    margin: 1rem 0 0;
  }

  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }

  .proof {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .proof li {
    display: grid;
    gap: 0.2rem;
    padding-left: 0.9rem;
    border-left: 2px solid var(--gold);
  }

  .value {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .label {
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* Same pills as the filters on /projects, so the two read as one control. */
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: -0.5rem 0 1.5rem;
  }

  .tabs button {
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .tabs button:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .tabs button[aria-selected="true"] {
    border-color: var(--accent);
    background: var(--accent-soft);
    color: var(--accent);
  }

  @media (pointer: coarse) {
    .tabs button {
      padding: 0.6rem 1rem;
    }
  }

  .panel[hidden] {
    display: none;
  }

  .more {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  .pin {
    margin-left: 0.6rem;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--gold);
    border-radius: 999px;
    color: var(--gold);
    letter-spacing: 0.1em;
  }

  .cards,
  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .cards {
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }

  .strip {
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .cards a,
  .strip a {
    display: block;
    height: 100%;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--surface);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }

  .cards a:hover,
  .strip a:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
  }

  /* Same surface, border and radius as the cards below, but not a link: the
     two buttons are the actions, so there is no hover lift on the card. */
  .resume-card {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 0.6rem;
    background: var(--surface);
  }

  .facts {
    display: grid;
    gap: 0.9rem;
    margin: 0;
  }

  .fact {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }

  .fact dt {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .fact dd {
