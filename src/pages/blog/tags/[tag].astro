---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Spotlight from "../../../components/Spotlight.astro";
import CursorRing from "../../../components/CursorRing.astro";
import { getPosts, postHref, collectTags, formatDate, readingTime } from "../../../lib/content";

export async function getStaticPaths() {
  const posts = await getPosts();
  return collectTags(posts).map((tag) => ({
    params: { tag: tag.slug },
    props: {
      label: tag.tag,
      posts: posts.filter((post) => post.data.tags.includes(tag.tag)),
    },
  }));
}

interface Props {
  label: string;
  posts: CollectionEntry<"blog">[];
}

const { label, posts } = Astro.props;
---

<BaseLayout title={`Tagged ${label}`} description={`Posts tagged ${label}.`}>
  <Spotlight />
  <CursorRing />

  <div class="page">
    <p class="crumbs"><a href="/blog">Writing</a></p>
    <h1>Tagged <span class="tag">{label}</span></h1>
    <p class="lede">{posts.length} {posts.length === 1 ? "post" : "posts"}.</p>

    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <a
              href={postHref(post)}
              {...(post.data.external ? { target: "_blank", rel: "noopener" } : {})}
            >
              <h2>
                {post.data.title}
                {post.data.external && <span class="out" aria-hidden="true">↗</span>}
              </h2>
              <p class="summary">{post.data.description}</p>
              <p class="meta">
                <span>{formatDate(post.data.date)}</span>
                {post.data.external ? (
                  <span class="where">{post.data.external.publication}</span>
                ) : (
                  <span>{readingTime(post.body)} min read</span>
                )}
              </p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</BaseLayout>

<style>
  .page {
    position: relative;
    z-index: 1;
    max-width: 52rem;
    margin: 0 auto;
    padding: clamp(1rem, 4vh, 3rem) clamp(1rem, 4vw, 2.5rem) 6rem;
  }

  .crumbs {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--muted);
    margin: 0 0 2rem;
  }

  h1 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    margin: 0;
  }

  .tag {
    color: var(--accent);
  }

  .lede {
    color: var(--muted);
  }

  .posts {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
  }

  .posts a {
    display: block;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  .posts h2 {
    font-family: var(--font-body);
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0;
  }

  .posts a:hover h2 {
    color: var(--accent);
  }

  .out {
    font-size: 0.8em;
    color: var(--muted);
    margin-left: 0.3rem;
  }

  .summary {
    margin: 0.35rem 0 0.5rem;
    color: var(--muted);
  }

  .meta {
    display: flex;
    gap: 0.9rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    color: var(--muted);
  }

  .where {
    color: var(--accent);
  }
</style>
