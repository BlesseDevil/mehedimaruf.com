---
/**
 * The line-and-label section navigator.
 *
 * Three placements, one mechanic:
 *   rail   — fixed to the left edge, for the home page on a wide screen
 *   column — inside the CV's sticky left column
 *   bar    — a scrollable row of chips, pinned under the header on a phone
 *
 * A page may render more than one of these (a rail for desktop, a bar for
 * mobile), and every instance stays in step: the observer updates all of them.
 */
interface Props {
  sections: { id: string; label: string }[];
  /**
   * Other pages, listed after the sections. Without these the
   * navigator only moved around the page it was on, and the home page had no
   * visible way to reach Projects or Writing.
   */
  pages?: { href: string; label: string }[];
  variant?: "column" | "rail" | "bar";
}

const { sections, pages = [], variant = "column" } = Astro.props;
---

<nav class:list={["section-nav", variant]} aria-label="Sections" data-section-nav>
  <ul>
    {
      sections.map((section) => (
        <li>
          <a href={`#${section.id}`} data-nav-link={section.id}>
            <span class="line" aria-hidden="true" />
            <span class="label">{section.label}</span>
          </a>
        </li>
      ))
    }
    {
      pages.map((page, index) => (
        <li class:list={["page", index === 0 && "first-page"]}>
          <a href={page.href}>
            <span class="line" aria-hidden="true" />
            <span class="label">{page.label}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .section-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    /* Tight enough that ten sections plus the actions fit a laptop screen
       without the list needing to scroll inside the column. */
    padding: 0.22rem 0;
    text-decoration: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .line {
    display: block;
    height: 1px;
    width: 1.75rem;
    background: currentColor;
    transition: width var(--dur) var(--ease), background var(--dur) var(--ease);
  }

  a:hover,
  a:focus-visible {
    color: var(--text);
  }

  a:hover .line,
  a:focus-visible .line {
    width: 2.75rem;
  }

  /* Set by the observer below. */
  a[aria-current="true"] {
    color: var(--accent);
  }

  a[aria-current="true"] .line {
    width: 3.25rem;
    background: var(--accent);
  }

  /* Links to other pages look exactly like the sections until
     the last section (Contact) is reached. There the reading is over and the
     next move is to another page, so they open out into buttons. */
  .page a {
    border: 1px solid transparent;
    border-radius: 0.45rem;
    transition:
      color var(--dur) var(--ease),
      border-color var(--dur) var(--ease),
      background var(--dur) var(--ease),
      padding var(--dur) var(--ease),
      margin var(--dur) var(--ease);
  }

  /* data-at-end is set by the script once the last section is on screen. */
  .section-nav[data-at-end] .first-page a,
  .section-nav[data-at-end] .page:not(.first-page) a {
    margin-top: 0.35rem;
    padding: 0.5rem 0.8rem;
    border-color: var(--accent);
    color: var(--accent);
  }

  .section-nav[data-at-end] .first-page a:hover,
  .section-nav[data-at-end] .page:not(.first-page) a:hover {
    background: var(--accent-soft);
  }

  /* The line folds away rather than vanishing, so the label slides into the
     button instead of jumping. The negative margin takes back the flex gap. */
  .page .line {
    transition:
      width var(--dur) var(--ease),
      margin var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .section-nav[data-at-end] .first-page .line,
  .section-nav[data-at-end] .page:not(.first-page) .line {
    width: 0;
    margin-right: -0.75rem;
    opacity: 0;
  }

  /* The arrow belongs to the button, not to the plain link: it takes no room
     until the end of the page, then slides in from the left. On hover it
     leans towards where the link goes. */
  .arrow {
    max-width: 0;
    margin-left: -0.75rem;
    overflow: hidden;
    opacity: 0;
    transform: translateX(-0.4rem);
    transition:
      max-width var(--dur) var(--ease),
      margin var(--dur) var(--ease),
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .section-nav[data-at-end] .page .arrow {
    max-width: 1.5rem;
    margin-left: auto;
    opacity: 1;
    transform: none;
  }

  .section-nav[data-at-end] .page a:hover .arrow,
  .section-nav[data-at-end] .page a:focus-visible .arrow {
    transform: translateX(0.3rem);
  }

  /* A chip has no room for it. */
  .bar .arrow {
    display: none;
  }

  /* In the chip bar they are chips already, so only the colour changes. */
  .bar .page a {
    border-color: var(--border);
    border-radius: 999px;
  }

  .section-nav.bar[data-at-end] .first-page a,
  .section-nav.bar[data-at-end] .page:not(.first-page) a {
    margin-top: 0;
    padding: 0.35rem 0.8rem;
    border-color: var(--accent);
  }

  /* ── rail ─────────────────────────────────────────────────────────────── */
  /* Part of the fixed left rail, which positions it; the labels stay visible
     rather than appearing on hover, so the sections can be read at a glance. */
  .rail ul {
    gap: 0.1rem;
  }

  /* ── bar ──────────────────────────────────────────────────────────────── */
  /* A row of chips that stays under the header while you read. It scrolls
     sideways rather than wrapping, so it is always exactly one line tall. */
  .bar ul {
    flex-direction: row;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    padding: 0.55rem 0;
  }

  .bar ul::-webkit-scrollbar {
    display: none;
  }

  .bar a {
    padding: 0.35rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .bar .line {
    display: none;
  }

  .bar a[aria-current="true"] {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  @media print {
    .section-nav {
      display: none;
    }
  }
</style>

<script>
  function initSectionNav() {
    const navs = [...document.querySelectorAll<HTMLElement>("[data-section-nav]")];
    if (navs.length === 0) return;

    // Every nav on the page tracks the same sections, so they are wired
    // together — a desktop rail and a mobile bar must never disagree.
    const links = new Map<string, HTMLAnchorElement[]>();
    for (const nav of navs) {
      if (nav.dataset.bound) continue;
      nav.dataset.bound = "true";
      for (const link of nav.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")) {
        const id = link.dataset.navLink!;
        links.set(id, [...(links.get(id) ?? []), link]);
      }
    }
    if (links.size === 0) return;

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (targets.length === 0) return;

    // Track how much of each section is on screen and mark the most visible
    // one, which behaves better than "first one crossing a line" for short
    // sections.
    const ratios = new Map<string, number>();

    // The last section is short and sits at the very bottom of the page, below
    // the band the main observer watches, so it could never win "most visible"
    // and the section before it stayed marked. It is tracked on its own: once
    // it is properly on screen the reader has reached the end.
    const last = targets[targets.length - 1]!;
    let atEnd = false;

    const paint = (best: string, bestRatio: number) => {
      for (const [id, group] of links) {
        for (const link of group) {
          if (id === best && bestRatio > 0) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
      }
    };

    let lastBest = "";
    let lastBestRatio = 0;

    new IntersectionObserver(
      ([entry]) => {
        atEnd = !!entry && entry.isIntersecting;
        // The page links open out into buttons at the end; see the styles.
        for (const nav of navs) nav.toggleAttribute("data-at-end", atEnd);
        if (atEnd) paint(last.id, 1);
        else paint(lastBest, lastBestRatio);
      },
      { threshold: 0.5 },
    ).observe(last);

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          ratios.set(entry.target.id, entry.isIntersecting ? entry.intersectionRatio : 0);
        }

        let best = "";
        let bestRatio = 0;
        for (const [id, ratio] of ratios) {
          if (ratio > bestRatio) {
            best = id;
            bestRatio = ratio;
          }
        }

        lastBest = best;
        lastBestRatio = bestRatio;
        if (atEnd) paint(last.id, 1);
        else paint(best, bestRatio);

        // Keep the active chip in view in the scrolling mobile bar — by
        // moving the bar itself, never with scrollIntoView.
        //
        // scrollIntoView({ block: "nearest" }) does not confine itself to the
        // horizontal axis: the bar is sticky and sits partly under the header,
        // so the browser judged it not fully visible and scrolled the PAGE to
        // fix that. That scroll changed which section was most visible, the
        // observer fired again, and it scrolled again — a feedback loop whose
        // constant direction changes made the header hide and reveal over and
        // over. Only the mobile bar exists to be scrolled into view, which is
        // why it never showed up on a desktop.
        const activeChip = document.querySelector<HTMLElement>(
          '.bar a[aria-current="true"]',
        );
        const track = activeChip?.closest<HTMLElement>(".bar ul");
        if (activeChip && track) {
          const left =
            activeChip.offsetLeft - (track.clientWidth - activeChip.offsetWidth) / 2;
          track.scrollTo({ left, behavior: "smooth" });
        }
      },
      { threshold: [0, 0.15, 0.4, 0.7, 1], rootMargin: "-10% 0px -40% 0px" },
    );

    for (const target of targets) observer.observe(target);
  }

  initSectionNav();
  document.addEventListener("astro:page-load", initSectionNav);
</script>
