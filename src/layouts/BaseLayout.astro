---
import "../styles/global.css";
import { SITE, EMAILS, PSEUDONYM } from "../config";
import ThemeToggle from "../components/ThemeToggle.astro";
import Portal from "../components/Portal.astro";
import CommandPalette from "../components/CommandPalette.astro";
import Socials from "../components/Socials.astro";
import { profile } from "../lib/site-data";
import { getProjects } from "../lib/content";

interface Props {
  title?: string;
  description?: string;
  /** Set on <article> pages that are written in Bangla. */
  lang?: string;
  /**
   * The header's copy of the name. Pages whose own large name shrinks into it
   * pass `morph`, and the mark then waits until that handover has happened.
   */
  mark?: boolean;
  markLabel?: string;
  morph?: boolean;
  /** An address shown beside the mark — the CV's, where it is the point. */
  headMail?: string;
}

const {
  title,
  description = SITE.description,
  lang = SITE.locale,
  mark = true,
  markLabel = SITE.shortName,
  morph = false,
  headMail,
} = Astro.props;
// Inner pages carry the short name: it is the one people search for, and the
// home page title already pairs it with the full one.
const pageTitle = title ? `${title} · ${SITE.shortName}` : SITE.title;
const canonical = new URL(Astro.url.pathname, SITE.url).href;

/**
 * On the home page the name is already enormous in the hero, so the header's
 * copy of it stays hidden until the big one has shrunk away. Everywhere else it
 * is there from the first pixel — that is the way back home from a long CV.
 */
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

/**
 * The footer is the site map people can read: every page of the site, every
 * published tool, and every place he can be found, on every page. It also
 * means each tool page is one link away from anywhere, which is what a search
 * engine uses to decide a page matters.
 */
const software = (await getProjects()).filter(
  (project) => project.data.band === "software" && !project.data.draft,
);

const footerColumns = [
  {
    title: "Site",
    links: [
      { label: "Home", href: "/" },
      { label: "Projects", href: "/projects" },
      { label: "Writing", href: "/blog" },
      { label: "Résumé", href: "/resume" },
      { label: "Full CV", href: "/cv" },
    ],
  },
  {
    title: "Software",
    links: software.map((project) => ({
      // "rSimpLone for Windows, Linux and macOS" is a page title; in a short
      // list the name alone is enough.
      label: project.data.title.split(" for ")[0]!,
      href: `/projects/${project.id}`,
    })),
  },
  {
    title: "Elsewhere",
    links: [
      ...profile.links.map((link) => ({ label: link.label, href: link.href, external: true })),
      { label: "RSS feed", href: "/rss.xml" },
      { label: "Sitemap", href: "/sitemap-index.xml" },
    ],
  },
].filter((column) => column.links.length > 0);

const ogImage = new URL(SITE.ogImage, SITE.url).href;

/**
 * Who this site is about, for search engines. The short name and the builder
 * name are listed as alternates so a search for either one lands here, and
 * `sameAs` ties the GitHub and LinkedIn profiles to the same person.
 */
const personLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${SITE.url}/#person`,
      name: SITE.name,
      alternateName: [SITE.shortName, PSEUDONYM.name],
      url: SITE.url,
      image: ogImage,
      description: SITE.description,
      jobTitle: "Software developer and linguist",
      knowsAbout: [
        "Open-source software",
        "Desktop applications",
        "Web applications",
        "Linguistics",
        "Language data",
        "Bangla natural language processing",
      ],
      sameAs: profile.links.map((link) => link.href),
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.shortName,
      alternateName: [SITE.name, PSEUDONYM.name],
      author: { "@id": `${SITE.url}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* Browser UI colour per theme — wine-black in Devil, champagne in Blessed. */}
    <meta name="theme-color" content="#FBF5EC" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A0B10" media="(prefers-color-scheme: dark)" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.shortName} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${SITE.shortName} (${PSEUDONYM.name})`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content={SITE.name} />

    {isHome && <script type="application/ld+json" set:html={JSON.stringify(personLd)} />}

    {/* Theme before paint: no flash of the wrong theme. Kept tiny and inline. */}
    <script is:inline>
      try {
        var saved = localStorage.getItem("mm-theme");
        if (saved === "blessed" || saved === "devil") {
          document.documentElement.dataset.theme = saved;
        }
      } catch (e) {
        /* blocked storage: fall through to the OS preference */
      }
    </script>

    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header
      class="site-head"
      data-header
      data-home={isHome ? "" : undefined}
      data-morph={morph ? "" : undefined}
    >
      {/* The bar is full-bleed so its blurred backing runs edge to edge; the
          contents are what stay inside the page's column. A backing that
          stopped at --page-max read as a lighter panel floating in the middle
          of the screen. */}
      <div class="head-inner">
        {mark && <a class="mark" href="/" data-site-mark>{markLabel}</a>}
        {headMail && (
          <a class="head-mail" href={`mailto:${headMail}`}>
            {headMail}
          </a>
        )}

        <div class="head-tools">
          <button class="search" type="button" data-palette-open aria-label="Search this site">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5" />
              <path d="m16 16 4.5 4.5" />
            </svg>
            <kbd>Ctrl K</kbd>
          </button>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    {/* Every page, not just the home page: it is how you reach him from
        wherever you happen to have stopped reading. On the home page it waits
        until the hero's own copy has been scrolled past. */}
    <div class="social-rail">
      {/* The line drops from the top of the screen into the icons, rather than
          hanging off the bottom of them with nothing to reach. */}
      <span class="divider" aria-hidden="true"></span>
      <Socials variant="rail" />
    </div>

    <footer class="site-foot">
      <div class="foot-inner">
        <div class="foot-brand">
          <a class="foot-name" href="/">{SITE.shortName}</a>
          <p>Linguist by training, developer by passion.</p>
          <p>
            Software published as{" "}
            <a href={PSEUDONYM.github} target="_blank" rel="noopener">{PSEUDONYM.name}</a>.
          </p>
          <a class="foot-mail" href={`mailto:${EMAILS.contact}`}>{EMAILS.contact}</a>
        </div>

        <nav class="foot-map" aria-label="Site map">
          {
            footerColumns.map((column) => (
              <div>
                <h2>{column.title}</h2>
                <ul>
                  {column.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        {...("external" in link ? { target: "_blank", rel: "noopener me" } : {})}
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>

      <p class="foot-legal">© {new Date().getFullYear()} {SITE.name}</p>
    </footer>

    {/* Always available, on every page — the way out to everything else. */}
    <Portal />
    <CommandPalette />

    <script>
      /**
       * Header behaviour: pinned, with every control always visible. It gains
       * a blurred backing once the page has scrolled.
       */
      function initHeader() {
        const header = document.querySelector<HTMLElement>("[data-header]");
        if (!header || header.dataset.bound) return;
        header.dataset.bound = "true";

        /**
         * Publish the bar's real height, so anything that pins itself beneath
         * it can use the measurement rather than a guess. The mobile chip bar
         * was pinned at a hard-coded 3.5rem against an 84px bar, and spent the
         * whole page with 28px of itself underneath.
         */
        const publishHeight = () =>
          document.documentElement.style.setProperty(
            "--head-h",
            `${header.getBoundingClientRect().height}px`,
          );
        new ResizeObserver(publishHeight).observe(header);
        publishHeight();

        let queued = false;

        // The bar and everything in it stay put while you scroll: the name,
        // search and the theme switch. The controls used to slide away on the
        // way down and come back on the way up, which left the bar looking
        // different from one moment to the next for no reason a reader could
        // see. Only the backing changes, once the page has moved.
        const apply = () => {
          queued = false;
          if (window.scrollY > 24) header.dataset.scrolled = "";
          else delete header.dataset.scrolled;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(apply);
          },
          { passive: true },
        );

        apply();
      }

      initHeader();
      document.addEventListener("astro:page-load", initHeader);
    </script>
  </body>
</html>

<style>
  /* Sticky. The background only appears once the page has scrolled, so at the
     top it is invisible over the hero. */
  .site-head {
    position: sticky;
    top: 0;
    z-index: 30;
    transition: background 280ms var(--ease);
  }

  .head-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 1.25rem clamp(1rem, 4vw, 2.5rem);
  }

  /* With no mark the tools still belong on the right. */
  .head-tools {
    margin-left: auto;
  }

  .site-head[data-scrolled] {
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
  }

  /* Where a large name on the page shrinks into it, the mark is the landing
     point of that handover, so it fades in only once it has happened. */
  .site-head[data-morph] .mark,
  .site-head[data-morph] .head-mail {
    opacity: 0;
    pointer-events: none;
    transition: opacity 200ms var(--ease);
  }

  .site-head[data-morph][data-title-parked] .mark,
  .site-head[data-morph][data-title-parked] .head-mail {
    opacity: 1;
    pointer-events: auto;
  }

  .head-mail {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease), opacity 200ms var(--ease);
  }

  .head-mail:hover {
    color: var(--accent);
  }

  /* On a narrow bar the name is the one that has to survive. */
  @media (max-width: 48rem) {
    .head-mail {
      display: none;
    }
  }

  .mark {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
  }

  .mark:hover {
    color: var(--accent);
  }

  .head-tools {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .search {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
  }

  .search:hover {
    color: var(--accent);
    border-color: var(--border-strong);
  }

  .search svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .search kbd {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  /* The keyboard hint is noise on a touch device. */
  @media (max-width: 30rem), (pointer: coarse) {
    .search kbd {
      display: none;
    }
  }

  /* Top right, clear of the header's own controls. The bottom corners belong to
     the portal door, and the left gutter to the section names. */
  .social-rail {
    position: fixed;
    right: clamp(1rem, 3vw, 2.5rem);
    top: 4.75rem;
    z-index: 5;
    display: grid;
    justify-items: center;
    gap: 0.9rem;
    transition: opacity 320ms var(--ease), transform 320ms var(--ease);
  }

  /* On the home page the hero owns them to begin with: the header sets
     data-title-parked at the end of the shrink, and that is the cue to fly in.
     Everywhere else they are simply there. */
  .site-head[data-home]:not([data-title-parked]) ~ .social-rail {
    opacity: 0;
    transform: translateY(-0.6rem);
    pointer-events: none;
  }

  .social-rail .divider {
    width: 1px;
    height: 3rem;
    background: var(--border-strong);
  }

  /* The rail lives in the page gutter, so it waits until the gutter is wider
     than the rail itself. */
  @media (max-width: 80rem) {
    .social-rail {
      display: none;
    }
  }

  @media print {
    .social-rail {
      display: none;
    }
  }

  /* Who he is on the left, the site map on the right, one quiet legal line
     underneath. The links are muted until hovered: a footer full of accent
     colour reads as a second navigation bar competing with the page. */
  .site-foot {
    max-width: var(--page-max);
    margin: 5rem auto 0;
    padding: 0 clamp(1rem, 4vw, 2.5rem);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .foot-inner {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto;
    gap: 2.5rem clamp(2rem, 6vw, 5rem);
    /* Extra room underneath keeps the last link above the Explore door. */
    padding-block: 2.5rem 3.75rem;
    border-top: 1px solid var(--border);
  }

  .foot-name {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 0.6rem;
  }

  .foot-mail {
    display: block;
    width: fit-content;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    text-decoration: none;
    margin-top: 0.9rem;
  }

  .foot-mail:hover {
    text-decoration: underline;
  }

  .foot-name:hover {
    color: var(--accent);
  }

  .foot-brand p {
    margin: 0;
    max-width: 44ch;
    line-height: 1.6;
  }

  .foot-map {
    display: grid;
    grid-template-columns: repeat(3, max-content);
    gap: 2rem clamp(2rem, 5vw, 4rem);
  }

  /* The last column keeps the width it had when the contact address lived in
     it. That holds all three columns a little further left, so the last one
     stays out from under the Explore door in the corner. */
  @media (min-width: 34.0625rem) {
    .foot-map > div:last-child {
      min-width: 11.5rem;
    }
  }

  .foot-map h2 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0.35rem 0 0.9rem;
  }

  .foot-map ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .foot-map a {
    color: var(--muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .foot-map a:hover,
  .foot-map a:focus-visible {
    color: var(--text);
  }

  /* The right side of this line is left empty on purpose: the Explore door is
     fixed to that corner and used to sit on top of the footer's last link. */
  .foot-legal {
    margin: 0;
    padding: 1.25rem 7rem 2rem 0;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
  }

  @media (max-width: 56rem) {
    .foot-inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 34rem) {
    .foot-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media print {
    .site-head,
    .site-foot {
      display: none;
    }
  }

  /* The sticky header must not cover an anchor target — measured, plus room
     for the chip bar that pins itself underneath. */
  :global(html) {
    scroll-padding-top: calc(var(--head-h, 5.25rem) + 3.5rem);
  }
</style>
